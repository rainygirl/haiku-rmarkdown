resource app_signature "application/x-vnd.RMarkdown";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "R Markdown",
	long_info  = "A Markdown editor that styles the text in place."
};

/* Markdown icon, HVIF: a page with a folded corner carrying a
   pair of asterisks -- the ** that marks bold. Flat shapes and
   straight edges only, which is what survives being drawn at 16
   pixels in the Deskbar. */
